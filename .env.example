# Application Settings
APP_NAME="Cloud Migration Command Center"
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
DATABASE_URL=sqlite:///./migration_cmd_center.db

# OpenAI (required for KLO AI features)
OPENAI_API_KEY=sk-...

# Backend API URL (used by Streamlit frontend)
BACKEND_URL=http://localhost:8000

# Auth (optional – for enterprise SSO)
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1
